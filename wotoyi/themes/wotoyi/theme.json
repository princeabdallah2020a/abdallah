          "name": "section",
          "size": "var(--wy-space-section)"
        },
        {
          "slug": "gutter",
          "name": "gutter",
          "size": "var(--wy-space-gutter)"
        }
      ],
      "padding": true,
      "margin": true,
      "blockGap": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "elev-1",
          "name": "Elevation 1",
          "shadow": "var(--wy-elev-1)"
        },
        {
          "slug": "elev-2",
          "name": "Elevation 2",
          "shadow": "var(--wy-elev-2)"
        },
        {
          "slug": "elev-3",
          "name": "Elevation 3",
          "shadow": "var(--wy-elev-3)"
        },
        {
          "slug": "elev-4",
          "name": "Elevation 4",
          "shadow": "var(--wy-elev-4)"
        }
      ]
    },
    "border": {
      "radius": true,
      "color": true,
      "style": true,
      "width": true
    },
    "custom": {
      "layout": {
        "header": "var(--wy-layout-header-h)",
        "touch": "var(--wy-layout-touch-min)"
      },
      "radius": {
        "xs": "var(--wy-radius-xs)",
        "sm": "var(--wy-radius-sm)",
        "md": "var(--wy-radius-md)",
        "lg": "var(--wy-radius-lg)",
        "xl": "var(--wy-radius-xl)",
        "pill": "var(--wy-radius-pill)"
      },
      "motion": {
        "easing": "var(--wy-easing-out)",
        "ui": "var(--wy-duration-ui)"
      }
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": true
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wy-color-base)",
      "text": "var(--wy-color-contrast)"
    },
    "typography": {
      "fontFamily": "var(--wy-font-sans)",
      "fontSize": "var(--wy-font-size-body)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "0"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wy-color-accent-text)"
        },
        ":hover": {
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "heading": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.2"
        }
      },
      "h1": {
        "typography": {
          "fontFamily": "var(--wy-font-display)",
          "fontWeight": "400",
          "fontSize": "var(--wy-font-size-display-m)",
          "lineHeight": "1.08"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wy-font-display)",
          "fontWeight": "400",
          "fontSize": "var(--wy-font-size-display-m)",
          "lineHeight": "1.08"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wy-font-size-h3)",
          "letterSpacing": "-0.01em"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wy-font-size-h4)"
        }
      },
      "button": {
        "color": {
          "gradient": "var(--wy-gradient-sunset)",
          "text": "var(--wy-color-accent-ink)"
        },
        "border": {
          "radius": "var(--wy-radius-pill)"
        },
        "typography": {
          "fontWeight": "700"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        }
      }
    },
    "blocks": {
      "core/separator": {
        "color": {
          "text": "var(--wy-color-border)"
        }
      },
      "core/quote": {
        "border": {
          "width": "0 0 0 3px",
          "color": "var(--wy-color-accent-graphic)"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "En-tete",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Pied de page",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-night",
      "title": "Page nocturne (pleine largeur)",
      "postTypes": [
        "page"
      ]
    }
  ],
  "patterns": []
}
