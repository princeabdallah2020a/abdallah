{
  "$description": "Wotoyi Design System v2 'Luxe Motion' tokens. Source of truth for theme.json, CSS custom properties (--wy-<path joined by '-'>) and the Wotoyi Pro PWA. Colours validated WCAG AA by scripts/contrast.py + wotoyi/design/contrast_ext.py against wotoyi/design/palette.json (2026-11-17, 0 failures). Any colour change must update palette.json and re-run both scripts.",
  "$version": "2.0.0",

  "color": {
    "light": {
      "base":            { "$value": "#F7F4EE", "$description": "porcelain page background" },
      "surface":         { "$value": "#FFFFFF", "$description": "cards, panels, inputs" },
      "surface-2":       { "$value": "#EFE8DC", "$description": "sand: secondary panels, filter panel, tab bar" },
      "surface-3":       { "$value": "#E5DBCB", "$description": "deep sand: chips, hover rows, skeleton base" },
      "contrast":        { "$value": "#0C111C", "$description": "ink: primary text" },
      "muted":           { "$value": "#4A5263", "$description": "secondary text, placeholders" },
      "border":          { "$value": "#E2D9CB", "$description": "decorative dividers only (not a component boundary)" },
      "border-strong":   { "$value": "#857B6E", "$description": "input/checkbox outlines, component boundaries (>=3:1)" },
      "accent":          { "$value": "#F2A93B", "$description": "gold fill for buttons/highlights; ALWAYS with accent-ink text; never as icon/line on light bg" },
      "accent-ink":      { "$value": "#0C111C", "$description": "text/icons on accent or sunset gradient" },
      "accent-text":     { "$value": "#94480A", "$description": "links, accent text" },
      "accent-graphic":  { "$value": "#B8700F", "$description": "accent icons, rating/price underline, progress lines on light bg" },
      "secondary":       { "$value": "#0A6670", "$description": "teal: secondary actions, info, links in Pro" },
      "secondary-ink":   { "$value": "#FFFFFF", "$description": "text on secondary fill" },
      "success":         { "$value": "#146B3F" },
      "warning":         { "$value": "#8A5200" },
      "danger":          { "$value": "#B3261E" },
      "focus":           { "$value": "#0A6670", "$description": "focus ring 2px + 2px offset" },
      "sunset-1":        { "$value": "#F7C964" },
      "sunset-2":        { "$value": "#F2A93B" },
      "sunset-3":        { "$value": "#EA8A3A" },
      "sunset-text-1":   { "$value": "#A85A0C", "$description": "gradient TEXT stops in light mode (background-clip:text)" },
      "sunset-text-2":   { "$value": "#8A3F06" },
      "night":           { "$value": "#06080F", "$description": "cinematic hero, footer, Prestige sections" },
      "on-night":        { "$value": "#F5F2EC" },
      "on-night-muted":  { "$value": "#AFB5C3" },
      "glass-night":     { "$value": "#1A1F2B", "$description": "opaque fallback of night glass" },
      "chrome":          { "$value": "#C9CED6", "$description": "decorative metal highlight, never text" },
      "whatsapp":        { "$value": "#146B3F", "$description": "WhatsApp button fill = success green (white text 6.55:1). Brand green #25D366 fails with white text; use only for the icon on dark bg" },
      "overlay":         { "$value": "rgba(6,8,15,0.56)", "$description": "modal/sheet scrim" }
    },
    "dark": {
      "base":            { "$value": "#07090F", "$description": "ink page background" },
      "surface":         { "$value": "#10141D", "$description": "graphite cards" },
      "surface-2":       { "$value": "#171C28" },
      "surface-3":       { "$value": "#202636" },
      "contrast":        { "$value": "#F2EFE9" },
      "muted":           { "$value": "#A4ABBA" },
      "border":          { "$value": "#252B3A" },
      "border-strong":   { "$value": "#6F7789" },
      "accent":          { "$value": "#FFB547" },
      "accent-ink":      { "$value": "#0C111C" },
      "accent-text":     { "$value": "#FFC968" },
      "accent-graphic":  { "$value": "#FFB547" },
      "secondary":       { "$value": "#3CCFC0" },
      "secondary-ink":   { "$value": "#06221F" },
      "success":         { "$value": "#4ADE80" },
      "warning":         { "$value": "#FBBF24" },
      "danger":          { "$value": "#FF8A80" },
      "focus":           { "$value": "#FFC968" },
      "sunset-1":        { "$value": "#FFD47E" },
      "sunset-2":        { "$value": "#FFB547" },
      "sunset-3":        { "$value": "#F5953F" },
      "sunset-text-1":   { "$value": "#FFD47E" },
      "sunset-text-2":   { "$value": "#F5953F" },
      "night":           { "$value": "#030509" },
      "on-night":        { "$value": "#F5F2EC" },
      "on-night-muted":  { "$value": "#AFB5C3" },
      "glass-night":     { "$value": "#141823" },
      "chrome":          { "$value": "#C9CED6" },
      "whatsapp":        { "$value": "#146B3F", "$description": "same fill both modes; white text" },
      "overlay":         { "$value": "rgba(0,0,0,0.64)" }
    }
  },

  "gradient": {
    "sunset":       { "$value": "linear-gradient(135deg, var(--wy-color-sunset-1) 0%, var(--wy-color-sunset-2) 50%, var(--wy-color-sunset-3) 100%)", "$description": "primary button, logo disc, active chips; text on it = accent-ink" },
    "sunset-text":  { "$value": "linear-gradient(100deg, var(--wy-color-sunset-text-1), var(--wy-color-sunset-text-2))", "$description": "one emphasised word per headline max" },
    "chrome-line":  { "$value": "linear-gradient(90deg, transparent, rgba(255,255,255,0.35), transparent)", "$description": "1px top hairline on night/dark cards" },
    "aurora": {
      "$value": [
        "radial-gradient(40% 50% at 20% 30%, rgba(242,169,59,0.35), transparent 70%)",
        "radial-gradient(35% 45% at 80% 20%, rgba(60,207,192,0.24), transparent 70%)",
        "radial-gradient(45% 55% at 60% 90%, rgba(200,85,31,0.22), transparent 70%)"
      ],
      "$description": "three layers, each on its own pseudo-element/div over color.night; animate transform only"
    },
    "scrim-bottom": { "$value": "linear-gradient(to top, rgba(6,8,15,0.82) 0%, rgba(6,8,15,0) 60%)", "$description": "under text placed on photos" }
  },

  "font": {
    "family": {
      "display":    { "$value": "'Instrument Serif', 'Iowan Old Style', Georgia, serif", "$description": "OFL 1.1; 400 + italic; headlines >= 32px only" },
      "sans":       { "$value": "'Manrope', 'Segoe UI', Roboto, system-ui, sans-serif", "$description": "OFL 1.1; variable wght 200-800; UI, body, prices" },
      "display-ar": { "$value": "'Noto Kufi Arabic', 'Manrope', sans-serif", "$description": "OFL 1.1; variable wght 100-900; Arabic headlines" },
      "sans-ar":    { "$value": "'IBM Plex Sans Arabic', 'Manrope', sans-serif", "$description": "OFL 1.1; static 400/500/600; Arabic UI/body" }
    },
    "weight": { "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "bold": { "$value": 700 }, "extrabold": { "$value": 800 } },
    "size": {
      "display-xl": { "$value": "clamp(2.75rem, 1.4rem + 5.6vw, 6.75rem)", "$description": "home hero H1; lh 0.98; tracking -0.02em" },
      "display-l":  { "$value": "clamp(2.25rem, 1.4rem + 3.6vw, 4.5rem)",  "$description": "section titles; lh 1.02; tracking -0.015em" },
      "display-m":  { "$value": "clamp(1.875rem, 1.4rem + 2vw, 3rem)",     "$description": "vehicle title, dealer name; lh 1.08" },
      "h3":         { "$value": "clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem)", "$description": "sans 700; lh 1.2; tracking -0.01em" },
      "h4":         { "$value": "1.25rem",  "$description": "sans 700; lh 1.3" },
      "body-l":     { "$value": "1.125rem", "$description": "lh 1.6" },
      "body":       { "$value": "1rem",     "$description": "lh 1.6; min for public body text" },
      "body-s":     { "$value": "0.875rem", "$description": "lh 1.5; Pro tables, meta" },
      "caption":    { "$value": "0.8125rem","$description": "lh 1.4; tracking 0.01em; never below this" },
      "overline":   { "$value": "0.75rem",  "$description": "sans 700; uppercase; tracking 0.14em; Latin only (no uppercase in AR)" },
      "price-l":    { "$value": "clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem)", "$description": "sans 800; tabular-nums" },
      "price":      { "$value": "1.25rem",  "$description": "sans 800; tabular-nums; card price" }
    },
    "arabic-adjust": { "line-height-add": { "$value": 0.15 }, "letter-spacing": { "$value": "0" }, "size-scale": { "$value": 1.0, "$description": "verify visually; raise to 1.05 only if x-height looks small next to Latin" } }
  },

  "space": {
    "0": { "$value": "0" }, "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" },
    "5": { "$value": "20px" }, "6": { "$value": "24px" }, "8": { "$value": "32px" }, "10": { "$value": "40px" }, "12": { "$value": "48px" },
    "16": { "$value": "64px" }, "20": { "$value": "80px" }, "24": { "$value": "96px" }, "32": { "$value": "128px" },
    "section": { "$value": "clamp(64px, 4rem + 6vw, 160px)", "$description": "padding-block of public sections" },
    "section-pro": { "$value": "24px", "$description": "Pro panels" },
    "gutter": { "$value": "clamp(16px, 4vw, 40px)" }
  },

  "layout": {
    "container":      { "$value": "1320px" },
    "container-wide": { "$value": "1600px" },
    "measure":        { "$value": "68ch", "$description": "max line length of running text" },
    "filter-panel":   { "$value": "320px" },
    "sidebar-pro":    { "$value": "264px" },
    "rail-pro":       { "$value": "72px" },
    "ai-panel":       { "$value": "400px" },
    "header-h":       { "$value": "72px", "$description": "64px under 768px" },
    "touch-min":      { "$value": "44px" }
  },

  "breakpoint": {
    "sm": { "$value": "480px" }, "md": { "$value": "768px" }, "lg": { "$value": "1200px" }, "xl": { "$value": "1600px" }
  },

  "radius": {
    "xs": { "$value": "6px", "$description": "badges, tags" },
    "sm": { "$value": "10px", "$description": "inputs, small buttons in Pro" },
    "md": { "$value": "14px", "$description": "menus, tooltips, thumbnails" },
    "lg": { "$value": "20px", "$description": "vehicle cards, panels" },
    "xl": { "$value": "28px", "$description": "hero search card, sheets (top corners), media frames" },
    "pill": { "$value": "999px", "$description": "public buttons, chips, segmented controls" }
  },

  "elevation": {
    "light": {
      "1": { "$value": "0 1px 2px rgba(41,30,12,0.06), 0 1px 1px rgba(41,30,12,0.04)" },
      "2": { "$value": "0 2px 4px rgba(41,30,12,0.04), 0 8px 20px -4px rgba(41,30,12,0.10)" },
      "3": { "$value": "0 4px 8px rgba(41,30,12,0.05), 0 20px 44px -10px rgba(41,30,12,0.16)" },
      "4": { "$value": "0 8px 16px rgba(41,30,12,0.06), 0 36px 80px -16px rgba(41,30,12,0.24)" },
      "glow": { "$value": "0 12px 36px -12px rgba(234,138,58,0.55)", "$description": "primary CTA hover" }
    },
    "dark": {
      "1": { "$value": "inset 0 1px 0 rgba(255,255,255,0.04), 0 1px 2px rgba(0,0,0,0.5)" },
      "2": { "$value": "inset 0 1px 0 rgba(255,255,255,0.05), 0 10px 24px -6px rgba(0,0,0,0.6)" },
      "3": { "$value": "inset 0 1px 0 rgba(255,255,255,0.06), 0 24px 48px -12px rgba(0,0,0,0.7)" },
      "4": { "$value": "inset 0 1px 0 rgba(255,255,255,0.07), 0 40px 90px -20px rgba(0,0,0,0.8)" },
      "glow": { "$value": "0 12px 40px -10px rgba(255,181,71,0.45)" }
    }
  },

  "glass": {
    "light":       { "background": { "$value": "rgba(255,255,255,0.72)" }, "border": { "$value": "rgba(255,255,255,0.6)" }, "fallback": { "$value": "#FFFFFF" } },
    "light-media": { "background": { "$value": "rgba(255,255,255,0.88)" }, "$description": "when placed over photos/video" },
    "dark":        { "background": { "$value": "rgba(16,20,29,0.72)" }, "border": { "$value": "rgba(255,255,255,0.08)" }, "fallback": { "$value": "#10141D" } },
    "dark-media":  { "background": { "$value": "rgba(16,20,29,0.88)" } },
    "night":       { "background": { "$value": "rgba(12,17,28,0.78)" }, "border": { "$value": "rgba(255,255,255,0.10)" }, "fallback": { "$value": "#1A1F2B" }, "$description": "hero search card on night/aurora/photo" },
    "blur":        { "$value": "blur(16px) saturate(140%)" },
    "blur-lite":   { "$value": "none", "$description": "motion=lite or no backdrop-filter support: use fallback colour" }
  },

  "motion": {
    "duration": {
      "instant":  { "$value": "80ms",  "$description": "press feedback" },
      "micro":    { "$value": "160ms", "$description": "hover, toggles, chips (PROJECT §16.4: 120-200)" },
      "ui":       { "$value": "280ms", "$description": "menus, accordions, tabs, sheet snap (200-350)" },
      "page":     { "$value": "420ms", "$description": "view transitions, theme toggle (300-500)" },
      "reveal":   { "$value": "640ms", "$description": "scroll reveals, split-text words (editorial, below the fold only)" },
      "counter":  { "$value": "1200ms" },
      "stagger":  { "$value": "40ms",  "$description": "per item; cap total stagger at 320ms" },
      "ambient":  { "$value": "32s",   "$description": "aurora loop" },
      "marquee":  { "$value": "48s" }
    },
    "easing": {
      "out":    { "$value": "cubic-bezier(0.22, 1, 0.36, 1)",  "$description": "default: enters, reveals, hovers ('luxe')" },
      "in-out": { "$value": "cubic-bezier(0.65, 0, 0.35, 1)",  "$description": "position changes, view transitions, sheets" },
      "in":     { "$value": "cubic-bezier(0.55, 0, 1, 0.45)",  "$description": "exits only, at 0.75x duration" },
      "linear": { "$value": "linear", "$description": "marquee, ambient, scroll-linked" }
    },
    "distance": {
      "reveal": { "$value": "24px" }, "parallax-max": { "$value": "12%" }, "tilt-max": { "$value": "6deg" }, "magnetic-max": { "$value": "6px" }, "press-scale": { "$value": "0.97" }
    }
  },

  "z": {
    "base": { "$value": 0 }, "sticky": { "$value": 20 }, "header": { "$value": 30 }, "cta-bar": { "$value": 35 },
    "ai-fab": { "$value": 40 }, "drawer": { "$value": 50 }, "sheet": { "$value": 60 }, "modal": { "$value": 70 }, "toast": { "$value": 80 }, "cursor": { "$value": 90 }
  }
}
